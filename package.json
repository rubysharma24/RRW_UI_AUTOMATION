{
  "name": "roadready-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for RoadReady Wheels (staging)",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:login": "npx playwright test tests/login.spec.ts",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report",
    "codegen": "npx playwright codegen https://staging.roadreadywheels.com",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:generate:single": "npx allure generate allure-results --clean -o allure-report --single-file",
    "allure:open": "npx allure open allure-report",
    "allure:package": "npx playwright test && npx allure generate allure-results --clean -o allure-report --single-file && powershell Compress-Archive -Path allure-report\\index.html -DestinationPath allure-report.zip -Force",
    "drive:upload": "npx ts-node scripts/uploadReport.ts",
    "allure:full:drive": "npm run allure:package && npm run drive:upload",
    "summary:send": "npx ts-node scripts/sendSummaryEmail.ts",
    "test:summary": "npx playwright test & npm run summary:send"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "allure-playwright": "^3.12.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.6.1",
    "nodemailer": "^10.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "googleapis": "^178.1.1"
  }
}
